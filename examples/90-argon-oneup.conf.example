# ==============================================================================
# /etc/rpi-suspend.conf.d/90-argon-oneup.conf.example
# Example drop-in configuration override for the Argon ONE UP (CM5 Laptop)
# ==============================================================================
# Drop-in configuration overrides (*.conf) placed in /etc/rpi-suspend.conf.d/
# are loaded in lexical order and override both /etc/rpi-suspend.conf and
# the active hardware profile.
#
# To activate:
#   sudo cp examples/90-argon-oneup.conf.example /etc/rpi-suspend.conf.d/90-argon-oneup.conf
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HARDWARE PROFILE & DISPLAY TOPOLOGY
# ------------------------------------------------------------------------------
# Selects the built-in Argon ONE UP hardware profile
PROFILE="argon-oneup"

# Internal BOE 1920x1200 panel connector names:
# - 'eDP-1' is used when the custom rpi-vc4-edp kernel patch is active (native eDP bridge)
# - 'HDMI-A-2' (hdmi1) is the fallback connector on generic Raspberry Pi OS kernels
# External full-size HDMI port on the left chassis is 'HDMI-A-1' (hdmi0)
INTERNAL_DISPLAY="eDP-1 HDMI-A-2"


# ------------------------------------------------------------------------------
# 2. HARDWARE USB PORT POWER CUTS
# ------------------------------------------------------------------------------
# Physically cuts power to specific USB ports on the internal GL850G hub in sleep:
# - Port 4: SunplusIT HD Webcam (cuts ~0.2W idle drain and eliminates 9000 USB dwc2 IRQs/s)
# - Port 6: AMIRA internal keyboard controller & backlight LEDs
# - Port 7: AMIRA internal touchpad controller
# All ports are automatically powered back on in <0.2s upon wakeup.
CUSTOM_POWER_CUT_PATHS="/sys/bus/usb/devices/1-1:1.0/1-1-port[467]/disable"
SLEEP_CUSTOM_POWER_CUTS=true


# ------------------------------------------------------------------------------
# 3. AUDIO AUTOSUSPEND (TRRS HEADSET REMOTE UNBIND)
# ------------------------------------------------------------------------------
# The C-Media USB audio chip exposes a HID interface (1-1.1:1.3) for the 3.5mm
# TRRS inline headphone remote button (play/pause). The Linux 'usbhid' driver
# polls this button continuously, which prevents the audio chip from sleeping.
# Unbinding 1-1.1:1.3 allows the audio chip to enter true runtime autosuspend
# ('suspended' state). rpi-suspend rebinds it automatically on wakeup.
CUSTOM_USBHID_UNBIND="1-1.1:1.3"


# ------------------------------------------------------------------------------
# 4. WIRELESS RADIO & STORAGE POWER SAVINGS
# ------------------------------------------------------------------------------
# Soft-block Wi-Fi (BCM43455) via rfkill during sleep. Prevents the radio from
# waking up for router beacon frames / DTIM, saving ~0.3-0.5W. Reconnects on wake.
SLEEP_WIFI_RFKILL=true

# Soft-block Bluetooth via rfkill during sleep and restore state on wake.
SLEEP_BLUETOOTH_RFKILL=true

# Optional: Deep NVMe APST power-saving. Disabled by default (false) for compatibility.
# Set to 'true' only if your NVMe SSD controller is known to handle deep APST
# transitions reliably without PCIe wake timeouts.
# SLEEP_NVME_POWERSAVE=false

# MicroSD slot power-saving: unbinds empty slot during sleep to eliminate 20 IRQs/s.
# Fully safe: automatically bypassed if booted from SD card or if an SD card is inserted.
SLEEP_SD_SLOT_POWERSAVE=true


# ------------------------------------------------------------------------------
# 5. DOCKED CLAMSHELL MODE (External Monitor Handling)
# ------------------------------------------------------------------------------
# Enable smart clamshell operation:
# - Lid closed + external monitor connected: stays 100% awake, blanks internal screen
# - Lid closed + no external monitor: enters deep system suspend (s2idle)
CLAMSHELL_ENABLE=true

# Cut power to keyboard & touchpad behind closed lid to avoid accidental keypresses
CLAMSHELL_DISABLE_INTERNAL_INPUT=true


# ------------------------------------------------------------------------------
# 6. SAFETY WATCHDOGS
# ------------------------------------------------------------------------------
# Cleanly shut down system if battery drops by >10% during sleep to prevent deep discharge
WATCHDOG_MAX_BATTERY_LOSS_PERCENT=10
