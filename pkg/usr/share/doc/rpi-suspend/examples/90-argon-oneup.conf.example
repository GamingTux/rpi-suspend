# ==============================================================================
# /etc/rpi-suspend.conf.d/90-argon-oneup.conf.example
# Example drop-in configuration override for the Argon ONE UP (CM5 Laptop)
# ==============================================================================
# Drop-in configuration overrides (*.conf) placed in /etc/rpi-suspend.conf.d/
# are loaded in lexical order and override both /etc/rpi-suspend.conf and
# the active hardware profile.
#
# To use this override:
#   sudo cp examples/90-argon-oneup.conf.example /etc/rpi-suspend.conf.d/90-argon-oneup.conf
#
# Features configured here:
# - Active profile: argon-oneup
# - Internal display: eDP-1 (via kernel patch) or HDMI-A-2
# - USB power cuts: cuts power to PC Camera (port 4), Keyboard (port 6), Touchpad (port 7)
# - Audio autosuspend: unbinds TRRS headset remote HID (1-1.1:1.3) during sleep
# - Radio power: soft-blocks Wi-Fi and Bluetooth via rfkill during sleep
# - Clamshell: blanks internal display & cuts internal inputs when lid is closed
# ==============================================================================

PROFILE="argon-oneup"
INTERNAL_DISPLAY="eDP-1 HDMI-A-2"
CUSTOM_POWER_CUT_PATHS="/sys/bus/usb/devices/1-1:1.0/1-1-port[467]/disable"
CUSTOM_USBHID_UNBIND="1-1.1:1.3"
CLAMSHELL_ENABLE=true
CLAMSHELL_DISABLE_INTERNAL_INPUT=true
SLEEP_CUSTOM_POWER_CUTS=true
SLEEP_WIFI_RFKILL=true
SLEEP_BLUETOOTH_RFKILL=true
WATCHDOG_MAX_BATTERY_LOSS_PERCENT=10
